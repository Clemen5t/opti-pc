<Window x:Class="OptiPC.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Opti-PC" Height="820" Width="1180" MinHeight="720" MinWidth="1000" Background="#0B1220" Foreground="White">
<Window.Resources><Style TargetType="Button"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="14,10"/><Setter Property="Background" Value="#1D4ED8"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style><Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Padding" Value="10"/><Setter Property="Foreground" Value="White"/></Style></Window.Resources>
<Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock Text="Opti-PC" FontSize="32" FontWeight="Bold"/><TextBlock Text="Ryzen 7000 X3D • Radeon RX 7000 • Windows 11 • faible latence" Opacity=".72"/></StackPanel><StackPanel HorizontalAlignment="Right"><TextBlock Text="v0.2" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock x:Name="AdminText" Text="Administrateur" Opacity=".65"/></StackPanel></Grid>
<UniformGrid Grid.Row="1" Columns="5" Margin="0,18,0,14"><Button Content="Analyser" Click="Analyze_Click"/><Button Content="Benchmark avant/après" Click="Benchmark_Click"/><Button Content="OPTIMISER TOUT" Background="#16A34A" Click="Optimize_Click"/><Button Content="Pilotes / BIOS" Click="Drivers_Click"/><Button Content="Restaurer" Background="#B91C1C" Click="Restore_Click"/></UniformGrid>
<TabControl Grid.Row="2" Background="#111A2B" Foreground="White">
<TabItem Header="Tableau de bord"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><GroupBox Header="Matériel"><TextBlock x:Name="HardwareText" TextWrapping="Wrap"/></GroupBox><GroupBox Header="Windows / Gaming"><TextBlock x:Name="WindowsText" TextWrapping="Wrap"/></GroupBox><GroupBox Header="Réseau actif"><TextBlock x:Name="NetworkText" TextWrapping="Wrap"/></GroupBox></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><GroupBox Header="Pilotes"><TextBlock x:Name="DriversText" TextWrapping="Wrap"/></GroupBox><GroupBox Header="Profil"><TextBlock x:Name="ProfileText" Text="Aucun" TextWrapping="Wrap"/></GroupBox><GroupBox Header="BIOS (jamais modifié automatiquement)"><TextBlock Text="• EXPO : vérifier s'il est activé si la RAM possède un profil EXPO.&#10;• BIOS/AGESA : version stable MSI adaptée au 7800X3D.&#10;• PBO / Curve Optimizer : laissé intact ; tests de stabilité requis.&#10;• ReBAR / Smart Access Memory : vérifier qu'il est actif." TextWrapping="Wrap"/></GroupBox></StackPanel></Grid></ScrollViewer></TabItem>
<TabItem Header="Benchmark réseau"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Ping, jitter et pertes. Le DNS n'est pas présenté comme un moyen de réduire le ping en jeu."/><TextBox Grid.Row="1" x:Name="BenchmarkBox" Margin="0,12,0,0" Background="#09101E" Foreground="White" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
<TabItem Header="Démarrage"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Analyse uniquement : Opti-PC ne désactive pas aveuglément les logiciels de démarrage."/><TextBox Grid.Row="1" x:Name="StartupBox" Margin="0,12,0,0" Background="#09101E" Foreground="White" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
<TabItem Header="Journal"><TextBox x:Name="LogBox" Margin="16" Background="#09101E" Foreground="#D8E2FF" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem>
</TabControl>
<Grid Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Text="Prêt." Opacity=".8"/><ProgressBar x:Name="Progress" Width="260" Height="8" HorizontalAlignment="Right" Minimum="0" Maximum="100"/></Grid></Grid></Window>