<Window x:Class="OptiPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opti-PC" Height="760" Width="1100"
        MinHeight="680" MinWidth="980"
        Background="#0B1220" Foreground="White">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Opti-PC" FontSize="32" FontWeight="Bold"/>
            <TextBlock Text="Optimisation Windows 11 + réseau faible latence" Opacity="0.75" Margin="0,4,0,0"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,22,0,18">
            <Button Content="Analyser" Margin="6" Padding="14" Click="Analyze_Click"/>
            <Button Content="Optimiser automatiquement" Margin="6" Padding="14" Click="Optimize_Click"/>
            <Button Content="Tester le réseau" Margin="6" Padding="14" Click="NetworkTest_Click"/>
            <Button Content="Restaurer" Margin="6" Padding="14" Click="Restore_Click"/>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#111A2B" CornerRadius="12" Padding="18" Margin="0,0,9,0">
                <StackPanel>
                    <TextBlock Text="État du PC" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HardwareText" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <Separator Margin="0,16"/>
                    <TextBlock Text="Profil appliqué" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProfileText" Text="Aucun"/>
                    <Separator Margin="0,16"/>
                    <TextBlock Text="Réseau" FontWeight="SemiBold"/>
                    <TextBlock x:Name="NetworkText" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#111A2B" CornerRadius="12" Padding="18" Margin="9,0,0,0">
                <StackPanel>
                    <TextBlock Text="Journal" FontSize="20" FontWeight="SemiBold"/>
                    <TextBox x:Name="LogBox" Margin="0,12,0,0" Background="#0A1020" Foreground="#D8E2FF"
                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="True" Height="460"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,18,0,0" Opacity="0.8" Text="Prêt."/>
    </Grid>
</Window>
