<Window x:Class="OptiPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opti-PC" Height="880" Width="1220" MinHeight="760" MinWidth="1040"
        Background="#0B1220" Foreground="White">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="14,10"/><Setter Property="Background" Value="#1D4ED8"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Padding" Value="10"/><Setter Property="Foreground" Value="White"/></Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="Opti-PC" FontSize="32" FontWeight="Bold"/><TextBlock Text="Windows 11 • Ryzen X3D • Radeon RX 7000 • optimisation mesurée et réversible" Opacity=".72"/></StackPanel>
            <StackPanel HorizontalAlignment="Right"><TextBlock Text="v0.3" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock x:Name="AdminText" Text="Administrateur" Opacity=".65"/></StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="ProfileSelector" SelectedIndex="0" Margin="5" Padding="10"><ComboBoxItem Content="Auto recommandé"/><ComboBoxItem Content="Compétitif / latence minimale"/><ComboBoxItem Content="Équilibré / stabilité"/></ComboBox>
            <UniformGrid Grid.Column="1" Columns="5"><Button Content="Analyser" Click="Analyze_Click"/><Button Content="Benchmark" Click="Benchmark_Click"/><Button Content="OPTIMISER TOUT" Background="#16A34A" Click="Optimize_Click"/><Button Content="Pilotes / BIOS" Click="Drivers_Click"/><Button Content="Restaurer" Background="#B91C1C" Click="Restore_Click"/></UniformGrid>
        </Grid>
        <TabControl Grid.Row="2" Background="#111A2B" Foreground="White">
            <TabItem Header="Tableau de bord"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><GroupBox Header="Matériel"><TextBlock x:Name="HardwareText" TextWrapping="Wrap"/></GroupBox><GroupBox Header="Windows / Gaming"><TextBlock x:Name="WindowsText" TextWrapping="Wrap"/></GroupBox><GroupBox Header="Réseau actif"><TextBlock x:Name="NetworkText" TextWrapping="Wrap"/></GroupBox></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><GroupBox Header="Pilotes"><TextBlock x:Name="DriversText" TextWrapping="Wrap"/></GroupBox><GroupBox Header="Profil appliqué"><TextBlock x:Name="ProfileText" Text="Aucun" TextWrapping="Wrap"/></GroupBox><GroupBox Header="Actions automatiques sûres"><TextBlock Text="• Sauvegarde + point de restauration avant modification.&#10;• Mode Jeu, HAGS et capture en arrière-plan ajustés selon le profil.&#10;• RSS conservé actif.&#10;• RSC testé A/B : le meilleur résultat est conservé.&#10;• Économie d'énergie réseau réduite si le pilote le permet.&#10;• Realtek 8125BG : EEE/Green Ethernet désactivés si exposés par le pilote.&#10;• Aucun overclock/undervolt automatique." TextWrapping="Wrap"/></GroupBox></StackPanel></Grid></ScrollViewer></TabItem>
            <TabItem Header="Benchmark réseau"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Mesures : passerelle locale + Cloudflare + Google. Ping, jitter, pertes et score comparatif. Un test court reste sensible à la charge du réseau."/><TextBox Grid.Row="1" x:Name="BenchmarkBox" Margin="0,12,0,0" Background="#09101E" Foreground="White" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
            <TabItem Header="Réseau avancé"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Détection des propriétés réellement exposées par le pilote : aucune valeur fabricant n'est inventée."/><TextBox Grid.Row="1" x:Name="AdvancedNetworkBox" Margin="0,12,0,0" Background="#09101E" Foreground="White" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
            <TabItem Header="Démarrage"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Opti-PC inventorie le démarrage mais ne désactive pas automatiquement des applications personnelles : le gain est faible et le risque de casser un usage est réel."/><TextBox Grid.Row="1" x:Name="StartupBox" Margin="0,12,0,0" Background="#09101E" Foreground="White" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
            <TabItem Header="Journal"><TextBox x:Name="LogBox" Margin="16" Background="#09101E" Foreground="#D8E2FF" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem>
        </TabControl>
        <Grid Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Text="Prêt." Opacity=".8"/><ProgressBar x:Name="Progress" Width="280" Height="8" HorizontalAlignment="Right" Minimum="0" Maximum="100"/></Grid>
    </Grid>
</Window>